# IBM Cloud & Granite LLM Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# IBM Cloud API Key (for IBM Granite LLM access)
IBM_CLOUD_API_KEY=

# IBM Cloud Project ID (from IBM Cloud Resource Group)
IBM_CLOUD_PROJECT_ID=

# IBM Granite LLM Endpoint
IBM_GRANITE_ENDPOINT=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID (e.g., ibm/granite-13b-chat-v2)
IBM_GRANITE_MODEL=ibm/granite-13b-chat-v2

# Application Mode: 'mock' | 'granite'
# Use 'mock' for local demo without IBM Cloud credentials
AI_PROVIDER=mock

# Backend API URL (for when the backend is running separately)
VITE_API_URL=http://localhost:3001/api

# App Mode
VITE_APP_ENV=development
